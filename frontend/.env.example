# For local development, leave this unset — the app uses Vite's dev proxy
# (see vite.config.js) to reach the backend at 127.0.0.1:8000.
#
# For production (Vercel/Netlify build settings), set this to your deployed
# FastAPI backend's URL, e.g.:
# VITE_API_BASE_URL=https://crimesense-api.onrender.com
VITE_API_BASE_URL=
